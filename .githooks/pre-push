#!/bin/sh
set -e

current_branch=$(git rev-parse --abbrev-ref HEAD)
push_remote="${1:-origin}"
pushed_refs=$(cat)

# ============================================================================
# Protected branch guard
# ============================================================================
# main/develop are also protected server-side (PR required, no force-push).
# This local guard fails fast before the round-trip to GitHub. Only blocks
# pushes that actually update refs/heads/main or refs/heads/develop — a tag
# push (e.g. a release tag, or changesets/action's own tag push) targets
# refs/tags/*, a different ref namespace, and is allowed even when main or
# develop happens to be the currently checked-out branch.

blocked_ref=$(echo "$pushed_refs" | awk '{print $3}' | grep -E '^refs/heads/(main|develop)$' | head -1)

if [ -n "$blocked_ref" ]; then
  blocked_branch=$(echo "$blocked_ref" | sed 's#refs/heads/##')
  echo ""
  echo "ERROR: direct push to '$blocked_branch' is not allowed."
  echo "Open a pull request instead: feature branches -> develop, release/hotfix -> main."
  exit 1
fi

non_tag_refs=$(echo "$pushed_refs" | awk '{print $3}' | grep -v '^refs/tags/' || true)

if [ -n "$pushed_refs" ] && [ -z "$non_tag_refs" ]; then
  echo "Tag-only push detected — skipping branch checks."
  exit 0
fi

# ============================================================================
# Branch naming convention
# ============================================================================

case "$current_branch" in
  feature/*|bugfix/*|chore/*|docs/*|test/*|refactor/*|perf/*|ci/*|build/*|release/*|hotfix/*|changeset-release/*) ;;
  *)
    echo ""
    echo "WARNING: branch '$current_branch' doesn't match the naming convention"
    echo "(feature/*, bugfix/*, chore/*, docs/*, test/*, refactor/*, perf/*, ci/*, build/*, release/*, hotfix/*)."
    echo "Pushing anyway — rename before opening a PR if this was unintentional."
    ;;
esac

# ============================================================================
# Changeset presence (mirrors .github/workflows/changeset-check.yml)
# ============================================================================
# Skip for branches that don't PR into develop, and for docs/ci-only branches.

case "$current_branch" in
  release/*|hotfix/*|changeset-release/*|docs/*|ci/*) ;;
  *)
    COUNT=$(find .changeset -maxdepth 1 -name '*.md' ! -name 'README.md' 2>/dev/null | wc -l | tr -d ' ')
    if [ "$COUNT" -eq 0 ]; then
      echo ""
      echo "ERROR: no changeset found for this branch."
      echo "Run 'pnpm exec changeset' to describe your change, or push a docs/*|ci/* branch to skip this."
      exit 1
    fi
    ;;
esac

# ============================================================================
# Full CI gate
# ============================================================================

echo ""
echo "Running full CI checks before push (root, then all workspace packages)..."
pnpm run ci
pnpm -r run ci

echo "Pre-push checks passed"
exit 0
