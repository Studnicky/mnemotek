{
  "name": "@studnicky/mnemotek",
  "version": "0.1.2",
  "description": "A typed command manifest foundation for agentic CLIs, skills, and MCP tools.",
  "author": "Andrew Studnicky <a.j.studnicky@gmail.com>",
  "homepage": "https://github.com/Studnicky/mnemotek#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Studnicky/mnemotek.git"
  },
  "bugs": {
    "url": "https://github.com/Studnicky/mnemotek/issues"
  },
  "keywords": [
    "agent",
    "ai",
    "cli",
    "mcp",
    "skill",
    "command",
    "manifest",
    "json-schema"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./entities": {
      "types": "./dist/entities/index.d.ts",
      "import": "./dist/entities/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "packageManager": "pnpm@10.32.1",
  "private": false,
  "scripts": {
    "build": "pnpm exec tsc --project tsconfig.json",
    "ci": "pnpm run typecheck && pnpm run lint && pnpm run typecheck:test && pnpm run test",
    "changeset": "pnpm exec changeset",
    "changeset:status": "pnpm exec changeset status",
    "changeset:version": "pnpm exec changeset version",
    "publish:all": "pnpm publish --access public --no-git-checks",
    "generate:og": "node scripts/generate-og.mjs",
    "clean": "pnpm exec tsc -b --clean",
    "prepare": "git config core.hooksPath .githooks || true",
    "lint": "pnpm exec eslint . --max-warnings 0",
    "prepack": "pnpm run generate:og && pnpm run clean && pnpm run build",
    "prepublishOnly": "pnpm run generate:og && pnpm run ci",
    "test": "pnpm run build && pnpm run typecheck:test && node --import tsx --test tests/unit/**/*.spec.ts",
    "typecheck": "pnpm exec tsc --project tsconfig.json --noEmit",
    "typecheck:test": "pnpm exec tsc --project tsconfig.tests.json --noEmit",
    "release": "pnpm run ci"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@studnicky/eslint-config": "^9.1.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "ajv": "^8.20.0",
    "eslint": "^10.8.0",
    "eslint-plugin-boundaries": "^7.1.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-perfectionist": "^5.10.0",
    "eslint-plugin-regexp": "^3.1.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "json-schema-to-ts": "^3.1.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "@studnicky/json": "^9.2.0",
    "commander": "^14.0.0",
    "enquirer": "^2.4.1"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
